{
  "name": "autovolt",
  "version": "0.1.0",
  "private": true,
  "description": "AUTOVOLT - Plataforma de gestao e crescimento para esteticas automotivas",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-deploy.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate:new": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "smoke": "node scripts/smoke.mjs",
    "test:clientes": "node scripts/test-clientes.mjs",
    "test:veiculos": "node scripts/test-veiculos.mjs",
    "test:servicos": "node scripts/test-servicos.mjs",
    "test:agenda": "node scripts/test-agenda.mjs",
    "test:ordens": "node scripts/test-ordens.mjs",
    "test:orcamentos": "node scripts/test-orcamentos.mjs",
    "test:retencao": "node scripts/test-retencao.mjs",
    "test:campanhas": "node scripts/test-campanhas.mjs",
    "test:equipe": "node scripts/test-equipe.mjs",
    "test:seguranca": "node scripts/test-seguranca.mjs",
    "test:relatorios": "node scripts/test-relatorios.mjs",
    "test:responsivo": "node scripts/test-responsivo.mjs",
    "test:mobile": "node scripts/test-mobile-forms.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
