# ORCAIA - variaveis de ambiente
#
# Copie para .env e preencha. Nunca comite o .env real.

# Conexao PostgreSQL. Em desenvolvimento pode apontar para um banco local.
# Ex.: postgresql://postgres:postgres@localhost:5432/orcaia?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/orcaia?schema=public"

# Conexao direta usada pelas migrations (build). No Neon/Vercel e criada
# automaticamente como DATABASE_URL_UNPOOLED pela integracao. Sem pooler
# (ex.: banco local), use o MESMO valor de DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/orcaia?schema=public"

# Segredo para assinar as sessoes JWT (cookie httpOnly).
# Gere um valor forte, ex.: `openssl rand -base64 48`
AUTH_SECRET="troque-por-um-segredo-forte-e-aleatorio"

# URL publica da aplicacao (usada em links de e-mail, futuros).
APP_URL="http://localhost:3000"
