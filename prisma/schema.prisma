// AUTOVOLT - Schema multi-tenant
//
// Todo dado operacional pertence a uma Company (empresa/estetica automotiva).
// O acesso de um User a uma Company acontece SEMPRE via Membership, e todas as
// queries da aplicacao sao escopadas por `companyId` (ver src/lib/tenant.ts).
//
// Producao roda em PostgreSQL (Neon). O schema foi escrito sem enums nativos
// justamente para que a migracao a partir de SQLite fosse direta — se quiser
// rodar localmente contra SQLite de novo, basta trocar o provider abaixo e
// apontar DATABASE_URL para "file:./dev.db".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade e multi-empresa
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarColor  String   @default("#12E29B")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  contactLogs     ContactLog[]
  invitesSent     Invitation[] @relation("InvitationCreatedBy")
  invitesAccepted Invitation[] @relation("InvitationAcceptedBy")

  @@map("users")
}

model Company {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  document              String? // CNPJ
  phone                 String?
  email                 String?
  city                  String?
  state                 String?
  address               String?
  logoUrl               String?
  plan                  String   @default("trial") // trial | starter | pro
  // Regras de negocio usadas pelo motor de retencao
  retentionWindowDays   Int      @default(90) // ciclo ideal de retorno do cliente
  inactiveAfterDays     Int      @default(180) // a partir daqui o cliente e "inativo"
  // Depois de um contato registrado, por quantos dias o cliente sai da fila de
  // prioridade. NAO altera o estagio de retencao dele — so a ordem da fila.
  contactCooldownDays   Int      @default(7)
  // Janela de atribuicao das campanhas: por quantos dias depois do envio uma OS
  // concluida ainda conta como conversao daquela campanha.
  attributionWindowDays Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  memberships          Membership[]
  customers            Customer[]
  vehicles             Vehicle[]
  serviceItems         ServiceItem[]
  appointments         Appointment[]
  quotes               Quote[]
  workOrders           WorkOrder[]
  campaigns            Campaign[]
  contactLogs          ContactLog[]
  campaignParticipants CampaignParticipant[]
  invitations          Invitation[]

  @@map("companies")
}

// Vinculo usuario <-> empresa. Um usuario pode operar varias empresas.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("owner") // owner | manager | staff
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

// Convite para alguem entrar em uma empresa.
//
// Nao substitui o Membership: e o passo anterior a ele. Quando o convite e
// aceito, o Membership da empresa e criado com o papel registrado aqui — a
// estrutura de acesso continua sendo a mesma de sempre.
model Invitation {
  id        String @id @default(cuid())
  companyId String
  email     String
  // owner | manager | staff — os mesmos papeis do Membership.
  role      String @default("staff")
  // 32 bytes aleatorios em base64url. Vai na URL do convite e e a unica coisa
  // que prova quem foi convidado, entao nao pode ser adivinhavel.
  token     String @unique
  // pendente | aceito | revogado. "Expirado" nao e status: sai da comparacao
  // com expiresAt, para nao existirem duas verdades sobre a mesma data.
  status    String @default("pendente")

  invitedById  String?
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy  User?   @relation("InvitationCreatedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Cadastros
// ---------------------------------------------------------------------------

model Customer {
  id        String    @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  document  String?
  birthDate DateTime?
  notes     String?
  origin    String    @default("indicacao") // indicacao | instagram | google | passagem | outro
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles             Vehicle[]
  appointments         Appointment[]
  quotes               Quote[]
  workOrders           WorkOrder[]
  contactLogs          ContactLog[]
  campaignParticipants CampaignParticipant[]

  @@index([companyId, name])
  @@map("customers")
}

model Vehicle {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  brand      String
  model      String
  year       Int?
  plate      String?
  color      String?
  size       String   @default("medio") // pequeno | medio | grande | suv
  mileage    Int? // quilometragem registrada no ultimo atendimento
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  quotes       Quote[]
  workOrders   WorkOrder[]

  @@index([companyId])
  @@index([customerId])
  @@map("vehicles")
}

// Catalogo de servicos da estetica (lavagem, polimento, vitrificacao...)
model ServiceItem {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String?
  category       String   @default("lavagem") // lavagem | polimento | protecao | higienizacao | estetica | outro
  basePrice      Int // centavos
  durationMin    Int      @default(60)
  // Em quantos dias esse servico costuma precisar ser refeito.
  // E o coracao das oportunidades de retorno.
  recurrenceDays Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments   AppointmentService[]
  quoteItems     QuoteItem[]
  workOrderItems WorkOrderItem[]

  @@index([companyId])
  @@map("service_items")
}

// ---------------------------------------------------------------------------
// Operacao
// ---------------------------------------------------------------------------

model Appointment {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  vehicleId  String?
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("agendado") // agendado | confirmado | em_andamento | concluido | cancelado | nao_compareceu
  // Valor combinado com o cliente. Nulo = usar a soma dos precos dos servicos
  // do catalogo (comportamento historico). Preenchido = valor negociado.
  priceCents Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  services  AppointmentService[]
  workOrder WorkOrder?

  @@index([companyId, startsAt])
  @@map("appointments")
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceItemId String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, serviceItemId])
  @@map("appointment_services")
}

model Quote {
  id            String    @id @default(cuid())
  companyId     String
  number        Int
  customerId    String
  vehicleId     String?
  status        String    @default("rascunho") // rascunho | enviado | aprovado | recusado | expirado | cancelado
  validUntil    DateTime?
  discountCents Int       @default(0)
  totalCents    Int       @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  items      QuoteItem[]
  workOrders WorkOrder[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("quotes")
}

model QuoteItem {
  id             String  @id @default(cuid())
  quoteId        String
  serviceItemId  String?
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int

  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

model WorkOrder {
  id            String    @id @default(cuid())
  companyId     String
  number        Int
  customerId    String
  vehicleId     String?
  // @unique: um orcamento gera no maximo UMA ordem de servico. Mesma protecao
  // que appointmentId ja tinha — a duplicacao passa a ser impossivel no banco,
  // nao apenas checada na aplicacao.
  quoteId       String?   @unique
  appointmentId String?   @unique
  status        String    @default("aberta") // aberta | em_andamento | aguardando_retirada | concluida | cancelada
  paymentMethod String? // pix | dinheiro | credito | debito | link
  totalCents    Int       @default(0)
  notes         String?
  openedAt      DateTime  @default(now())
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  quote               Quote?               @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  appointment         Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items               WorkOrderItem[]
  campaignParticipant CampaignParticipant?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, finishedAt])
  @@map("work_orders")
}

model WorkOrderItem {
  id             String  @id @default(cuid())
  workOrderId    String
  serviceItemId  String?
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int

  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@map("work_order_items")
}

// ---------------------------------------------------------------------------
// Crescimento
// ---------------------------------------------------------------------------

// Registro de um contato de retencao feito com o cliente.
//
// E a memoria que faltava na fila de retencao: sem isso o mesmo cliente
// reaparece como prioridade todo dia, mesmo depois de ja ter sido chamado.
// Nao interfere no calculo do estagio (novo/em dia/atencao/em risco/inativo) —
// so alimenta o cooldown da fila.
model ContactLog {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  // Quem registrou. Opcional para que a exclusao de um usuario nao apague o
  // historico de contatos da empresa.
  userId      String?
  channel     String   @default("whatsapp") // whatsapp | ligacao | instagram | outro
  outcome     String   @default("realizado") // realizado | respondeu | sem_resposta | sem_interesse | interessado | agendou_retorno
  contactedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, contactedAt])
  @@index([customerId, contactedAt])
  @@map("contact_logs")
}

model Campaign {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  channel        String    @default("whatsapp") // whatsapp | sms | email | instagram
  // Publico-alvo calculado pelo motor de retencao (src/lib/retention.ts)
  audience       String    @default("em_risco") // todos | em_risco | inativos | aniversariantes | sem_retorno | vip
  status         String    @default("rascunho") // rascunho | agendada | enviada | pausada
  message        String
  scheduledAt    DateTime?
  sentAt         DateTime?
  sentCount      Int       @default(0)
  answeredCount  Int       @default(0)
  convertedCount Int       @default(0)
  revenueCents   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  participants CampaignParticipant[]

  @@index([companyId, status])
  @@map("campaigns")
}

// Quem recebeu (ou vai receber) uma campanha.
//
// E o snapshot do publico no momento em que a campanha foi criada: o estagio de
// retencao fica congelado aqui, entao o participante continua na campanha mesmo
// que o motor de retencao reclassifique o cliente depois.
//
// Tambem e a fonte unica das metricas da campanha. Os contadores em Campaign
// (sentCount, answeredCount, convertedCount, revenueCents) sao apenas uma
// projecao recalculada a partir destas linhas — nenhum deles e digitado a mao.
model CampaignParticipant {
  id         String    @id @default(cuid())
  campaignId String
  companyId  String
  customerId String
  // Estagio de retencao do cliente quando o snapshot foi tirado.
  stage      String
  // pendente | enviado | nao_enviado | respondeu | sem_resposta
  status     String    @default("pendente")
  // Quando a mensagem foi de fato marcada como enviada para ESTE cliente.
  // E o marco que abre a janela de atribuicao.
  sentAt     DateTime?

  // Conversao atribuida. Gravada uma vez e preservada: relatorio nao muda
  // retroativamente. O @unique garante que uma mesma OS nunca gere receita em
  // duas campanhas — a duplicacao e impossivel no banco, nao apenas checada.
  workOrderId  String?   @unique
  convertedAt  DateTime?
  revenueCents Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  // Um cliente entra uma unica vez em cada campanha: nao ha como contar a mesma
  // conversao duas vezes dentro da campanha.
  @@unique([campaignId, customerId])
  @@index([companyId, customerId])
  @@index([campaignId, status])
  @@map("campaign_participants")
}
