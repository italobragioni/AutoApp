# Banco de dados (PostgreSQL — ex.: Neon, Vercel Postgres, Supabase)
DATABASE_URL="postgresql://user:password@host:5432/autovolt?sslmode=require"
# Para rodar localmente contra SQLite, troque o provider em prisma/schema.prisma
# de volta para "sqlite" e use: DATABASE_URL="file:./dev.db"

# Segredo usado para assinar o cookie de sessao (JWT). Troque em producao.
AUTH_SECRET="troque-este-segredo-por-uma-string-longa-e-aleatoria"

# URL publica da aplicacao
NEXT_PUBLIC_APP_URL="http://localhost:3000"
