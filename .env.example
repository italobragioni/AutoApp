# Banco de dados
# Dev (padrao): SQLite local
DATABASE_URL="file:./dev.db"
# Producao (PostgreSQL) - troque tambem o provider em prisma/schema.prisma
# DATABASE_URL="postgresql://user:password@host:5432/autovolt?schema=public"

# Segredo usado para assinar o cookie de sessao (JWT). Troque em producao.
AUTH_SECRET="troque-este-segredo-por-uma-string-longa-e-aleatoria"

# URL publica da aplicacao
NEXT_PUBLIC_APP_URL="http://localhost:3000"
