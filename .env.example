# Banco de dados (PostgreSQL)
#
# Desenvolvimento: aponte para um Postgres LOCAL. O seed (npm run db:seed) apaga
# a base antes de popular e so roda sem atrito quando o host e local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autovolt"
#
# Producao (Neon / Vercel Postgres / Supabase): definida no painel do provedor,
# nunca neste arquivo. O deploy aplica migrations com scripts/db-deploy.mjs e
# jamais executa o seed.

# Segredo usado para assinar o cookie de sessao (JWT). Troque em producao.
AUTH_SECRET="troque-este-segredo-por-uma-string-longa-e-aleatoria"

# URL publica da aplicacao. Usada para montar os links de recuperacao de senha,
# verificacao de e-mail e convite. Sem ela, o host da requisicao e usado.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envio de e-mail (recuperacao de senha e verificacao).
#
# Ainda nao ha provedor contratado. Ate haver, escolha o transporte:
#   console — imprime a mensagem no terminal do servidor (padrao em dev)
#   file    — grava em .mail-outbox.log, uma mensagem JSON por linha
#   none    — nao envia nada, so registra um aviso (padrao em producao)
#
# Quando houver provedor, ele entra como mais um caso em src/lib/mailer.ts e
# nenhuma tela precisa mudar.
# MAIL_TRANSPORT="console"

# ---------------------------------------------------------------------------
# Assinaturas e pagamentos (Cakto)
# ---------------------------------------------------------------------------
#
# O AUTOVOLT e um SaaS pago: a Cakto processa o pagamento e o backend controla o
# acesso pelo status da assinatura. Estes valores NUNCA vao para o navegador.
#
# Ambiente da integracao. Mantenha "sandbox" ate testar de ponta a ponta; troque
# para "production" so quando for cobrar de verdade. Nao misture credenciais.
# CAKTO_ENVIRONMENT="sandbox"
#
# Segredo do webhook, configurado no painel da Cakto. E o que prova que o webhook
# veio da Cakto — sem ele, o endpoint recusa TODOS os eventos (fail closed).
# CAKTO_WEBHOOK_SECRET=""
#
# Plano PROFESSIONAL. O id do produto e o link do checkout hospedado saem do
# painel da Cakto (aba de links do produto). O preco em centavos e so para exibir
# na tela e deve refletir o valor configurado na Cakto.
# CAKTO_PRODUCT_ID_PROFESSIONAL=""
# CAKTO_CHECKOUT_URL_PROFESSIONAL="https://pay.cakto.com.br/xxxxxxx"
# CAKTO_PRICE_PROFESSIONAL_CENTS="0"
#
# Reservado para uso futuro (criacao de cobranca via API). O checkout hospedado
# + webhook desta versao NAO precisa da chave de API.
# CAKTO_API_KEY=""
#
# Contas isentas de assinatura (e-mails separados por virgula). As empresas cujo
# DONO estiver nesta lista operam SEM assinatura ativa — util para a conta de
# demonstracao e contas internas. Se nao definida, o padrao ja isenta a conta
# demo (demo@autovolt.com.br). Deixe vazio ("") para nao isentar ninguem.
# BILLING_EXEMPT_EMAILS="demo@autovolt.com.br"
